# Version only the main application and its supporting code/configuration.
# Root allowlist: experiments, archives, datasets, standalone docs and local
# directories stay on this server. Add a root entry explicitly when needed.
/*
!/.gitignore
!/README.md
!/main.py
!/requirements.txt
!/pytest.ini
!/src/
!/models/
!/config/
!/scripts/
!/tests/
!/visualize/
!/runtime/

# Shared raw datasets and installed environments (not environment recipes).
/datasets/
/runtime/envs/
/runtime/**/*_site/
/runtime/**/*_cache/
.venv*/
.envs/
venv/
env/
ENV/

# External downstream checkouts are pinned in config/model_registry.json.
/models/downstream_generation_models/vendor/

# Python bytecode, compiled extensions, build products and tool caches.
__pycache__/
*.py[cod]
*.so
*.nbc
*.nbi
*.egg-info/
*.egg
.eggs/
build/
dist/
wheelhouse/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs, experiment trackers and scheduler output.
*.log
*.out
*.err
slurm-*.out
logs/
wandb/
lightning_logs/
mlruns/
events.out.tfevents.*

# Model weights and serialized data / intermediate arrays.
*.pt
*.pth
*.ckpt
*.ckpt.*
*.safetensors
*.onnx
*.pb
*.h5
*.hdf5
*.keras
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.mat
*.parquet
*.arrow
*.feather
*.csv
*.csv.gz
*.tsv
*.tsv.gz

# Downloaded packages, data bundles and container images.
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.zip
*.7z
*.rar
*.whl
*.sif
*.simg

# Nested repository internals, local editor settings and OS files.
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local credentials; retain safe, documented environment templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
