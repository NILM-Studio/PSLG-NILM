# Track only the current workflow at repository root.
/*
!/.gitignore
!/.github/
!/README.md
!/main.py
!/requirements.txt
!/pytest.ini
!/config/
!/models/
!/src/
!/scripts/
!/slurm/
!/tests/
!/visualize/
!/docs/
!/nilm_experiments/
!/runs/

# Local archives and state: never publish.
/legacy/
/.backups/
/.codex_work/
/.vscode/
/essays/
/input/
/datasets/
/.cache/
/log/
/log_det_test/
/output/
/determined/

# Current documentation only (historical reports remain local).
/docs/*
!/docs/TUTORIAL.md
!/docs/NILM_main_steps_models_and_metrics_20260917.md
!/docs/NILM_activity_primitive_generation_review_v2_20260917.md
!/docs/NILM_sequence_workflow_implementation_20260915.md
!/docs/NILM_primitive_state_definition_20260917.md

# Experiments: allow implementation and environment recipes, not campaigns.
/nilm_experiments/*
!/nilm_experiments/README.md
!/nilm_experiments/.gitignore
!/nilm_experiments/.dockerignore
!/nilm_experiments/requirements.txt
!/nilm_experiments/pyproject.toml
!/nilm_experiments/run_paths.py
!/nilm_experiments/sources.lock.json
!/nilm_experiments/nilm_lab/
!/nilm_experiments/generation_lab/
!/nilm_experiments/third_party/
!/nilm_experiments/runtime/
!/nilm_experiments/FCN/
!/nilm_experiments/scripts/
!/nilm_experiments/sequence_workflow_20260915/
!/nilm_experiments/primitive_vs_direct_20260915/
/nilm_experiments/sequence_workflow_20260915/*
!/nilm_experiments/sequence_workflow_20260915/manifest.json
/nilm_experiments/primitive_vs_direct_20260915/*
!/nilm_experiments/primitive_vs_direct_20260915/manifest.json
!/nilm_experiments/primitive_vs_direct_20260915/protocol.json

/runs/*
!/runs/README.md
!/runs/.gitignore

