# Publish only the main workflow, model implementations and release weights.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/main.py
!/src/
!/models/
!/config/
!/checkpoints/
__pycache__/
*.py[cod]
*.so
*.nbc
*.nbi
.git/
.venv*/
.env
.env.*
*.pem
*.key
*.log
.pytest_cache/
.ipynb_checkpoints/
# Dataset and experiment products never belong under source directories.
*.csv
*.h5
*.hdf5
*.npz
*.npy
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.index
*.data-*
!/checkpoints/**/
!/checkpoints/**/*.pt
!/checkpoints/**/*.pth
!/checkpoints/**/*.index
!/checkpoints/**/*.data-*

# Keep the explicitly restored notification workflow.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/feishu-notify.yml
